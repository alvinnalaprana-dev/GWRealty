      "parameters": {
        "jsCode": "// List agreement codes from the manager's agreement sheet. Column names are matched loosely.\nconst pick = (row, names) => { for (const k of Object.keys(row)) if (names.includes(k.trim().toLowerCase())) return row[k]; return ''; };\nconst list = $input.all().map(i => i.json).map(row => ({\n  code: String(pick(row, ['agreement code', 'agreement', 'code', 'kode']) || '').trim(),\n  villa: pick(row, ['villa', 'property']), tenant: pick(row, ['tenant', 'penyewa', 'name']),\n  checkIn: pick(row, ['check-in', 'check in', 'checkin', 'start']), checkOut: pick(row, ['check-out', 'check out', 'checkout', 'end'])\n})).filter(a => a.code);\nreturn [{ json: { ok: true, agreements: list } }];\n"
      }
    },
