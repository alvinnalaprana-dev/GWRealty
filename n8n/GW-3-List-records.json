      "parameters": {
        "jsCode": "// Return every record (parsed from dataJson), newest first.\nconst rows = $input.all().map(i => i.json).filter(r => r.dataJson);\nconst records = [];\nfor (const row of rows) { try { records.push(JSON.parse(row.dataJson)); } catch (e) { /* skip broken row */ } }\nrecords.sort((a, b) => String(b.updatedAt || '').localeCompare(String(a.updatedAt || '')));\nreturn [{ json: { ok: true, records } }];\n"
      }
