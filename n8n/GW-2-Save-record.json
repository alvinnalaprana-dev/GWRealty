      "name": "Photos to files",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "// Input: { record: {...}, photos: [{ id, phase, room, data: \"<base64 jpeg>\" }] }\n// Output: one item per photo with binary \"data\", or one marker item if there are no new photos.\nconst b = $input.first().json.body || {};\nconst r = b.record || {};\nif (!r.id) throw new Error('record.id is required');\nconst photos = Array.isArray(b.photos) ? b.photos : [];\nif (!photos.length) return [{ json: { none: true } }];\nreturn photos.map(p => ({\n  json: { photoId: p.id, phase: p.phase, room: p.room, fileName: `${r.agreement || r.id}_${p.phase}_${p.room}_${p.id}.jpg` },\n  binary: { data: { data: String(p.data).replace(/^data:image\\/\\w+;base64,/, ''), mimeType: 'image/jpeg', fileName: `${p.id}.jpg` } }\n}));\n"
      }
    },
