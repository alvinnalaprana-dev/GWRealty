    {
      "id": "ac59f0e1-4557-436a-bf92-d1fc3c6affed",
      "name": "Build row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "jsCode": "// Build the Records sheet row. Photo file IDs from Google Drive are merged into record.photoFiles.\nconst b = $('Webhook').first().json.body || {};\nconst r = Object.assign({}, b.record || {});\nr.photoFiles = Object.assign({}, r.photoFiles || {});\nif ($('Upload photo').isExecuted) {\n  const meta = $('Photos to files').all().map(i => i.json);\n  $('Upload photo').all().forEach((it, i) => { const m = meta[i]; if (m && m.photoId && it.json.id) r.photoFiles[m.photoId] = it.json.id; });\n}\nr.updatedAt = new Date().toISOString();\nreturn [{ json: {\n  recordId: r.id, agreement: r.agreement || '', villa: r.villaName || r.villaId || '', tenant: r.tenant || '',\n  status: r.status || '', invDate: r.invDate || '', checkIn: r.checkIn || '', checkOut: r.checkOut || '',\n  outInvDate: r.outInvDate || '', updatedAt: r.updatedAt, dataJson: JSON.stringify(r),\n  _photoFiles: r.photoFiles\n} }];\n"
      }
    },
